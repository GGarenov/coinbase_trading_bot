# Copy this file to .env.local and adjust if the engine isn't running with its defaults.
# .env.local itself is gitignored — see web/.gitignore's "env files" block.

# Base URL of the engine's HTTP API (see engine/src/index.ts — always bound to 127.0.0.1, matching
# this project's "never expose the engine to the network" posture). Must be NEXT_PUBLIC_-prefixed
# since src/lib/api.ts is called from client components running in the browser, not just from
# server components/route handlers — a plain (non-NEXT_PUBLIC_) env var would be undefined there.
# Defaults to http://127.0.0.1:4000 in src/lib/api.ts if unset, matching the engine's own default
# ENGINE_PORT — so this file (and a real .env.local) is only needed if you've changed that port.
NEXT_PUBLIC_ENGINE_URL=http://127.0.0.1:4000
