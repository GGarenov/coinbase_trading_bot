{
  "name": "coinbase-trading-bot",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "concurrently -n engine,web -c blue,green \"pnpm run dev:engine\" \"pnpm run dev:web\"",
    "dev:engine": "pnpm --filter @coinbase-trading-bot/engine dev",
    "dev:web": "pnpm --filter @coinbase-trading-bot/web dev",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs coinbase-trading-bot-engine",
    "pm2:save": "pm2 save"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pm2": "^7.0.4"
  }
}
