# Copy this file to .env and fill in real values. .env itself is gitignored — never commit real
# credentials. This file lists exactly the env vars the code actually reads today (checked via a
# grep across engine/src) — not everything PLAN.md originally sketched (see the DATABASE_URL note
# below).

# --- Coinbase CDP API credentials (LIVE trading only) ---
# Needed only for exchange/coinbase/tradingClient.ts's authenticated calls (placing/cancelling real
# orders, fetching real balances) — backtesting and paper trading use Coinbase's public, keyless
# endpoints and never read these. Leave blank until you actually intend to go live.
# Create one at https://portal.cdp.coinbase.com/ with Trade permission.
COINBASE_CDP_API_KEY_NAME=
COINBASE_CDP_PRIVATE_KEY=

# --- Engine process ---
# HTTP port the engine's Express server listens on (always bound to 127.0.0.1 only — see
# src/index.ts — never exposed to the network). Defaults to 4000 if unset.
ENGINE_PORT=4000

# Master switch for real-money trading. A session's mode must ALSO be LIVE in the database — this
# env var alone does nothing for PAPER/BACKTEST sessions. Leave unset (or "false") at all times
# until you have deliberately decided to trade with real funds; see
# docs/live-safety-test-plan.md before ever setting this to "true".
LIVE_TRADING_ENABLED=false

# --- Not currently used ---
# PLAN.md originally sketched a DATABASE_URL env var, but the actual Prisma 7 setup
# (packages/shared/prisma.config.ts + src/prisma.ts) hardcodes the path to data/bot.db directly
# via the driver adapter instead of reading it from the environment. Listed here for reference
# only — setting it currently has no effect.
# DATABASE_URL=file:./data/bot.db
